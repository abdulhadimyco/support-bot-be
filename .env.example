# Core
PORT=8086
NODE_ENV=development

REDIS_URL=redis://localhost:6379

# Chat Database (Sherlock's own DB for threads, messages, agents)
MONGO_CHAT_URI=mongodb://localhost:27017
MONGO_CHAT_DB=support_db

# Subscription Cluster (read-only)
MONGO_SUBSCRIPTION_URI=

# Production Cluster (read-only)
MONGO_PRODUCTION_URI=

# Payments Database — PostgreSQL (transactions, checkouts — read-only)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=payments

# Jira Integration
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BOARD_ID=178

# Auth (JWT secret — shared with auth service)
JWT_SECRET=your-secret-key-change-this-in-production

# AI Providers
MINIMAX_API_KEY=your-minimax-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
MINIMAX_MODEL=MiniMax-M2.7
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Logging
LOG_LEVEL=debug

# Observability
METRICS_ENABLED=true

# Cache
CACHE_ENABLED=true
CACHE_PREFIX=app:
CACHE_DEFAULT_TTL=3600

# Security
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
TRUST_PROXY=false

# App
APP_NAME=Sherlock
APP_VERSION=1.0.0
