# ── Core ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Databases ────────────────────────────────────────────────
MONGO_CHAT_URI=mongodb://localhost:27017
MONGO_CHAT_DB=support_db
MONGO_SUBSCRIPTION_URI=
MONGO_PRODUCTION_URI=

# Payments PostgreSQL (read-only)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=payments

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=

# ── AI Providers ─────────────────────────────────────────────
MINIMAX_API_KEY=
ANTHROPIC_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Jira ─────────────────────────────────────────────────────
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BOARD_ID=178

# ── SendGrid (dev alerts) ───────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@myco.io
DEV_ALERT_TO_EMAIL=

# ── Cloudflare R2 (file uploads) ────────────────────────────
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=sherlock-uploads
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Observability ────────────────────────────────────────────
LOG_LEVEL=info
METRICS_ENABLED=true

# ── Cache ────────────────────────────────────────────────────
REDIS_URL=
CACHE_ENABLED=true
CACHE_PREFIX=sherlock:
CACHE_DEFAULT_TTL=3600

# ── Security ─────────────────────────────────────────────────
CORS_ENABLED=true
CORS_ORIGIN=https://sherlock.myco.io
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
TRUST_PROXY=true

# ── App ──────────────────────────────────────────────────────
APP_NAME=Sherlock
APP_VERSION=1.0.0
