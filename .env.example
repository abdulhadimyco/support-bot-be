# Core
PORT=8086
NODE_ENV=development

# Database (myco production — read-only, used by tools in later phases)
MONGO_DATABASE_URL=mongodb://user:password@localhost:27017/mydb?authSource=admin
REDIS_URL=redis://localhost:6379

# Chat Database (c3pa's own DB for threads, messages, agents)
MONGO_CHAT_URI=mongodb://localhost:27017
MONGO_CHAT_DB=myco_support

# Auth (JWT secret — shared with myco auth service)
JWT_SECRET=your-secret-key-change-this-in-production

# AI Providers
MINIMAX_API_KEY=your-minimax-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
MINIMAX_MODEL=MiniMax-M2.7
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Logging
LOG_LEVEL=debug

# Observability
METRICS_ENABLED=true

# Cache
CACHE_ENABLED=true
CACHE_PREFIX=app:
CACHE_DEFAULT_TTL=3600

# Security
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
TRUST_PROXY=false

# App
APP_NAME=C3PA Support Bot
APP_VERSION=1.0.0
